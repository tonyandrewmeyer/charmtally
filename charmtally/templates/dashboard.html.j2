<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>charmtally — charm feature adoption</title>
<style>
  body { font: 14px/1.4 system-ui, sans-serif; margin: 2em; max-width: 1600px; }
  h1 { margin-bottom: 0; }
  .meta { color: #666; font-size: 12px; margin-bottom: 1.5em; }
  table { border-collapse: collapse; margin-bottom: 3em; }
  th, td { border: 1px solid #ddd; padding: 4px 8px; text-align: left; vertical-align: top; }
  th { background: #f4f4f4; cursor: pointer; user-select: none; }
  th:hover { background: #e8e8e8; }
  th.sorted-asc::after { content: " ▲"; color: #888; }
  th.sorted-desc::after { content: " ▼"; color: #888; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .gap { color: #b00; font-weight: 600; }
  .worth { color: #b67; }
  .ok { color: #060; }
  .lib-ops { color: #036; }
  .lib-pebble { color: #063; }
  .lib-jubilant { color: #630; }
  .lib-ops-scenario { color: #306; }
  .lib-charmlibs { color: #444; }
  .lib-python { color: #408; }
  .lib-metadata { color: #660; }
  details { margin-top: 1em; }
  details summary { cursor: pointer; color: #06b; }
  .ev { font-family: ui-monospace, monospace; font-size: 12px; color: #444; }
  .ev a { color: #06b; text-decoration: none; }
  .ev a:hover { text-decoration: underline; }
  nav a { margin-right: 1em; }

  /* Architecture / stack chips on charm rows */
  .chip {
    display: inline-block; font-size: 11px; line-height: 1; padding: 3px 7px;
    border-radius: 9px; background: #eef; color: #224; margin-right: 4px;
    margin-bottom: 2px; white-space: nowrap;
  }
  .chip-arch-delta              { background: #f0f0f0; color: #555; }
  .chip-arch-part-reconcile     { background: #fdf0d8; color: #7a5600; }
  .chip-arch-unconditional-init { background: #fde4c0; color: #7a4a00; }
  .chip-arch-reconcile          { background: #fde8c0; color: #6a4000; }
  .chip-arch-reconcile-all      { background: #fbd590; color: #6a4000; }
  .chip-arch-component-graph    { background: #d8e8ff; color: #154; }
  .chip-arch-reactive           { background: #fbe0e6; color: #802040; }
  .chip-arch-legacy-classic     { background: #ece0fb; color: #4a2080; }
  .chip-flag                  { background: #e8f4e8; color: #145; }
  .low-count {
    display: inline-block; font-size: 11px; padding: 1px 6px; margin-left: 6px;
    border-radius: 9px; background: #fff3cd; color: #7a5600; cursor: help;
    white-space: nowrap;
  }
  .stack {
    font-family: ui-monospace, monospace; font-size: 11.5px; color: #444;
    white-space: nowrap;
  }
  .stack .sep { color: #aaa; margin: 0 4px; }

  /* Top-of-page summary widget */
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1em;
    margin: 1em 0 2em 0;
  }
  .summary section {
    border: 1px solid #ddd; border-radius: 4px; padding: .6em .9em;
    background: #fafafa;
  }
  .summary h3 { margin: 0 0 .3em 0; font-size: 13px; color: #335;
                text-transform: uppercase; letter-spacing: .5px; }
  .summary dl { margin: 0; font-size: 13px; }
  .summary dt { display: inline-block; min-width: 8em; color: #555; }
  .summary dd { display: inline; margin-left: .4em; color: #112;
                font-variant-numeric: tabular-nums; }
  .summary dd::after { content: ""; display: block; }
  .summary .pct { color: #678; font-size: 11px; margin-left: .4em; }

  /* Filter bar above the charm view */
  .filters {
    display: flex; flex-wrap: wrap; gap: .4em .8em;
    align-items: center; margin: 0 0 .8em 0;
    font-size: 12px;
  }
  .filters .label { color: #555; text-transform: uppercase;
                    letter-spacing: .5px; font-weight: 600; }
  .filters button {
    border: 1px solid #ccc; background: #fff; color: #333;
    padding: 3px 9px; border-radius: 9px; cursor: pointer;
    font: inherit;
  }
  .filters button:hover { background: #f4f4f4; }
  .filters button.active { background: #224; color: #fff; border-color: #224; }
  .filters .group { display: flex; gap: .3em; }
  .filters .visible-count { margin-left: auto; color: #777; }
  .filters input[type="search"] {
    border: 1px solid #ccc; border-radius: 9px;
    padding: 3px 10px; font: inherit; min-width: 14em;
  }
  .filters input[type="search"]:focus { outline: 2px solid #ace; outline-offset: -1px; }
  .filters input[list] {
    border: 1px solid #ccc; border-radius: 9px;
    padding: 3px 10px; font: inherit; min-width: 12em;
  }
  .filters input[list]:focus { outline: 2px solid #ace; outline-offset: -1px; }
  .feature-chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .feature-chip {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; padding: 2px 4px 2px 8px; border-radius: 9px;
    background: #224; color: #fff; white-space: nowrap;
  }
  .feature-chip button {
    border: none; background: transparent; color: #fff;
    cursor: pointer; padding: 0 4px; font-size: 13px; line-height: 1;
  }
  .feature-chip button:hover { color: #f88; }
  .feature-chip .mode { opacity: .65; font-variant: small-caps; }
  .feature-chip-lacks { background: #7a2030; }
  .feature-chip-gap { background: #7a5600; }
  tr.hidden { display: none; }

  .filters select {
    border: 1px solid #ccc; border-radius: 9px;
    padding: 3px 6px; font: inherit; background: #fff; color: #333;
  }
  .filters select.set { background: #224; color: #fff; border-color: #224; }
  .filters button.clear-all {
    border-color: #ddd; color: #777;
  }
  .filters .help {
    color: #999; cursor: help; border-bottom: 1px dotted #bbb;
  }
  .filters .visible-count.filtered { color: #224; font-weight: 600; }
  /* Cross-links that pre-set the charm view's filters. */
  a.xlink { color: inherit; text-decoration: none;
            border-bottom: 1px dotted #bbb; }
  a.xlink:hover { border-bottom-style: solid; }
  .empty-state {
    color: #777; font-style: italic; margin: 0 0 3em 0;
  }
  table.all-hidden { display: none; }

  /* Per-architecture adoption pill in the feature view. */
  .arch-pct {
    display: inline-flex; align-items: baseline; gap: 4px;
    font-size: 11px; padding: 2px 7px; border-radius: 9px;
    background: #f0f0f0; color: #335; margin: 0 4px 2px 0;
    white-space: nowrap;
  }
  .arch-pct .name { color: #678; }
  .arch-pct .pct { font-variant-numeric: tabular-nums; font-weight: 600; }
  .arch-pct .pct-hi { color: #060; }
  .arch-pct .pct-mid { color: #b67; }
  .arch-pct .pct-lo { color: #b00; }
  .arch-pct .pct-na { color: #888; font-weight: 400; }

  /* AI-escalated badge (LLM upgraded worth-considering → clear-gap) */
  .ai-badge {
    display: inline-block; font-size: 10px; padding: 1px 5px; margin-left: 4px;
    border-radius: 9px; background: #e8f0fe; color: #1a56db;
    border: 1px solid #c0d4f7; white-space: nowrap; cursor: help;
    vertical-align: middle;
  }
</style>
</head>
<body>

<h1>charmtally</h1>
<p class="tagline">A feature-adoption survey of the Canonical charm fleet.</p>
<p class="meta">
  Scanned {{ charms|length }} charm{{ "" if charms|length == 1 else "s" }}
  against {{ features|length }} features.
  {% if generated_at %}Generated {{ generated_at }}.{% endif %}
</p>

<nav>
  <a href="#summary">Summary</a>
  <a href="#feature-view">Feature view</a>
  <a href="#charm-view">Charm view</a>
  <a href="#team-view">Team view</a>
  {% if pairs %}<a href="#pairs-view">Pairs</a>{% endif %}
  <a href="adoption.html">Adoption →</a>
  <a href="trend.html">History →</a>
</nav>

{% if summary %}
<section id="summary" class="summary">
  <section>
    <h3>Architecture</h3>
    <dl>
      {% for name, n in summary.architecture %}
        <dt><a class="xlink" href="?charm.arch={{ name|urlencode }}#charm-view"
               title="Show these charms in the charm view"><span class="chip chip-arch-{{ name }}">{{ name }}</span></a></dt>
        <dd>{{ n }}<span class="pct">{{ (100 * n / summary.total)|round(0, 'floor')|int }}%</span></dd>
      {% endfor %}
    </dl>
  </section>
  <section>
    <h3>Shape</h3>
    <dl>
      <dt><a class="xlink" href="?charm.shape=k8s#charm-view">k8s</a></dt><dd>{{ summary.k8s }}<span class="pct">{{ (100 * summary.k8s / summary.total)|round(0, 'floor')|int }}%</span></dd>
      <dt><a class="xlink" href="?charm.shape=machine#charm-view">machine</a></dt><dd>{{ summary.machine }}<span class="pct">{{ (100 * summary.machine / summary.total)|round(0, 'floor')|int }}%</span></dd>
      <dt><a class="xlink" href="?charm.arch=reactive#charm-view">reactive</a></dt><dd>{{ summary.reactive }}<span class="pct">{{ (100 * summary.reactive / summary.total)|round(0, 'floor')|int }}%</span></dd>
      <dt><a class="xlink" href="?charm.arch=legacy-classic#charm-view">legacy-classic</a></dt><dd>{{ summary.legacy_classic }}<span class="pct">{{ (100 * summary.legacy_classic / summary.total)|round(0, 'floor')|int }}%</span></dd>
      <dt><a class="xlink" href="?charm.flags=lib-provider#charm-view">lib provider</a></dt><dd>{{ summary.own_library }}<span class="pct">{{ (100 * summary.own_library / summary.total)|round(0, 'floor')|int }}%</span></dd>
      <dt><a class="xlink" href="?charm.flags=terraform#charm-view">terraform mod</a></dt><dd>{{ summary.terraform }}<span class="pct">{{ (100 * summary.terraform / summary.total)|round(0, 'floor')|int }}%</span></dd>
    </dl>
  </section>
  <section>
    <h3>Charmcraft plugin</h3>
    <dl>
      {% for name, n in summary.plugins[:6] %}
        <dt>{{ name }}</dt><dd>{{ n }}</dd>
      {% endfor %}
    </dl>
  </section>
  <section>
    <h3>Base</h3>
    <dl>
      {% for name, n in summary.bases %}
        <dt>{{ name }}</dt><dd>{{ n }}</dd>
      {% endfor %}
    </dl>
  </section>
  <section>
    <h3>Tooling</h3>
    <dl>
      {% for name, n in summary.tooling %}
        <dt><a class="xlink" href="?charm.tooling={{ name|urlencode }}#charm-view">{{ name }}</a></dt><dd>{{ n }}</dd>
      {% endfor %}
    </dl>
  </section>
</section>
{% endif %}

<h2 id="feature-view">By feature</h2>

<div class="filters" data-filter-bar="feature-table">
  <span class="label">Library:</span>
  <div class="group" data-multi="lib">
    <button class="active" data-value="">all</button>
    {% for lib in facets.libraries %}<button data-value="{{ lib }}">{{ lib }}</button>{% endfor %}
  </div>
  <span class="label">Only:</span>
  <div class="group" data-multi="only" data-match="all">
    <button data-value="gaps" title="Features with at least one clear-gap charm">with clear gaps</button>
    <button data-value="unused" title="Features no charm in the corpus uses">unused</button>
    <button data-value="low-count" title="Features flagged ⚠ low-count">low-count</button>
  </div>
  <input type="search" data-search-input placeholder="search feature / library…"
         title="Terms are ANDed. Prefix with - to exclude, use feature: or library: to target a field, and quote phrases."
         autocomplete="off">
  <button type="button" class="clear-all" data-clear>clear</button>
  <span class="visible-count" data-count></span>
</div>

<table id="feature-table">
  <thead>
    <tr>
      <th data-sort="text">Feature</th>
      <th data-sort="text">Library</th>
      <th data-sort="num">Present</th>
      <th data-sort="num">Clear gap</th>
      <th data-sort="num">Worth considering</th>
      <th data-sort="num">N/A</th>
      <th>By architecture</th>
      <th>Exemplars</th>
    </tr>
  </thead>
  <tbody>
  {% for f in feature_rows %}
    <tr
      data-lib="{{ f.library }}"
      data-only="{{ 'gaps ' if f.clear_gap }}{{ 'unused ' if not f.present }}{{ 'low-count' if f.low_count }}"
      data-name="{{ f.name|lower }}"
      data-library="{{ f.library|lower }}"
      data-search="{{ (f.name + ' ' + f.library)|lower }}"
    >
      <td>
        {{ f.name }}
        {% if f.low_count %}<span class="low-count" title="Fewer than 5 charms detected with this feature across the whole corpus — the detector may be too strict. Add `expected_rare: true` in features.yaml to suppress.">⚠ low-count</span>{% endif %}
      </td>
      <td class="lib-{{ f.library }}">{{ f.library }}</td>
      <td class="num ok">
        <a class="xlink" href="?charm.feat=has:{{ f.name|urlencode }}#charm-view"
           title="List the charms that have this feature">{{ f.present }}</a>
      </td>
      <td class="num{% if f.clear_gap %} gap{% endif %}">
        <a class="xlink" href="?charm.feat=gap:{{ f.name|urlencode }}#charm-view"
           title="List the charms with a clear gap on this feature">{{ f.clear_gap }}</a>
        {% if f.clear_gap_ai %}<span class="ai-badge" title="{{ f.clear_gap_ai }} of these were escalated from worth-considering by the LLM scoring pass">AI&nbsp;{{ f.clear_gap_ai }}</span>{% endif %}
      </td>
      <td class="num{% if f.worth %} worth{% endif %}">{{ f.worth }}</td>
      <td class="num">{{ f.na }}</td>
      <td>
        {% for a in f.arch_adoption -%}
          <span class="arch-pct" title="{{ a.tooltip }}">
            <span class="name">{{ a.arch }}</span>
            <span class="pct
              {%- if a.is_na %} pct-na
              {%- elif a.pct >= 80 %} pct-hi
              {%- elif a.pct >= 40 %} pct-mid
              {%- else %} pct-lo{% endif %}">{{ a.label }}</span>
          </span>
        {%- endfor %}
      </td>
      <td>
        {% for ex in f.exemplars[:3] -%}
          <a href="{{ ex.url }}">{{ ex.charm }}</a>{% if not loop.last %}, {% endif %}
        {%- endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="empty-state" data-empty-for="feature-table" hidden>No features match these filters.</p>

<h2 id="charm-view">By charm</h2>

<div class="filters" data-filter-bar="charm-table">
  <span class="label">Arch:</span>
  <div class="group" data-multi="arch">
    <button class="active" data-value="">all</button>
    {% for a, n in facets.architectures %}<button data-value="{{ a }}" title="{{ n }} charm{{ '' if n == 1 else 's' }}">{{ a }}</button>{% endfor %}
  </div>
  <span class="label">Shape:</span>
  <div class="group" data-single="shape">
    <button class="active" data-value="">any</button>
    <button data-value="k8s">k8s</button>
    <button data-value="machine">machine</button>
  </div>
  <span class="label">Status:</span>
  <div class="group" data-single="status">
    <button class="active" data-value="">any</button>
    <button data-value="has-gaps">has clear-gap</button>
    <button data-value="clean">no clear-gap</button>
  </div>
  <span class="label">Flags:</span>
  <div class="group" data-multi="flags" data-match="all">
    <button data-value="lib-provider">lib provider</button>
    <button data-value="subordinate">subordinate</button>
    <button data-value="workload-less">workload-less</button>
    <button data-value="terraform">terraform</button>
  </div>
  <select data-select="team" data-exact title="Filter by owning team">
    <option value="">every team</option>
    {% for t in facets.teams %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
  </select>
  <select data-select="tooling" title="Filter by test / lint tooling detected in the repo">
    <option value="">any tooling</option>
    {% for t in facets.tooling %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
  </select>
  <input type="search" data-search-input
         placeholder="search charm / team / repo / stack…"
         title="Terms are ANDed. Prefix with - to exclude, quote phrases, and target a field with charm: team: repo: stack: arch: flag: feature: gap:"
         autocomplete="off">
  <select data-feature-mode title="How the feature chips below are matched">
    <option value="has">has feature</option>
    <option value="lacks">lacks feature</option>
    <option value="gap">clear-gap on</option>
  </select>
  <input list="charm-feature-list" data-feature-input
         placeholder="add feature…" autocomplete="off">
  <datalist id="charm-feature-list">
    {% for f in features %}<option value="{{ f.name }}">{% endfor %}
  </datalist>
  <div class="feature-chips" data-feature-chips></div>
  <button type="button" class="clear-all" data-clear>clear all</button>
  <span class="visible-count" data-count></span>
</div>

<table id="charm-table">
  <thead>
    <tr>
      <th data-sort="text">Charm</th>
      <th data-sort="text">Team</th>
      <th data-sort="text">Architecture</th>
      <th data-sort="text">Stack</th>
      <th data-sort="num">Present</th>
      <th data-sort="num">Clear gap</th>
      <th data-sort="num">Worth considering</th>
      <th>Gaps</th>
    </tr>
  </thead>
  <tbody>
  {% for c in charm_rows %}
    <tr
      data-arch="{{ c.architecture|join(' ') }}"
      data-shape="{{ 'k8s' if c.k8s else 'machine' }}"
      data-status="{{ 'has-gaps' if c.clear_gap else 'clean' }}"
      data-flags="{{ c.flags|join(' ') }}"
      data-team="{{ c.team or '(no team)' }}"
      data-tooling="{{ c.tooling|join(' ') }}"
      data-features="{{ c.present_features|join(' ') }}"
      data-gaps="{{ c.gap_features|join(' ') }}"
      data-name="{{ c.name|lower }}"
      data-repo="{{ c.repo_url|lower }}"
      data-stack="{{ c.stack_text|lower }}"
      data-search="{{ (c.name + ' ' + c.team + ' ' + c.repo_url + ' ' + c.stack_text + ' ' + c.architecture|join(' ') + ' ' + c.flags|join(' '))|lower }}"
    >
      <td><a href="{{ c.repo_url }}">{{ c.name }}</a></td>
      <td>{{ c.team }}</td>
      <td>
        {% for a in c.architecture -%}
          <span class="chip chip-arch-{{ a }}">{{ a }}</span>
        {%- endfor %}
        {% if c.provides_own_library %}<span class="chip chip-flag" title="Charm publishes its own lib/charms/&lt;name&gt;/ library">lib provider</span>{% endif %}
        {% if c.is_subordinate %}<span class="chip chip-flag" title="subordinate: true in charm metadata — runs alongside a principal charm">subordinate</span>{% endif %}
        {% if c.is_workload_less %}<span class="chip chip-flag" title="Principal charm with no containers, no pebble layer, and no juju-info requires — manages no processes">workload-less</span>{% endif %}
      </td>
      <td class="stack">
        {{- "k8s" if c.k8s else "machine" -}}
        {% if c.plugins %}<span class="sep">·</span>{{ c.plugins|join(",") }}{% endif %}
        {% if c.bases %}<span class="sep">·</span>{{ c.bases|join(",") }}{% endif %}
        {% if c.min_juju %}<span class="sep">·</span>juju&nbsp;{{ c.min_juju }}{% endif %}
        {% if c.ops_requirement is not none %}<span class="sep" title="The `ops` version the charm asks for">·</span>ops&nbsp;{{ c.ops_requirement if c.ops_requirement else "*" }}{% endif %}
        {% if c.library_count %}<span class="sep">·</span>{{ c.library_count }}&nbsp;lib{{ "" if c.library_count == 1 else "s" }}{% endif %}
        {% if c.tooling %}<span class="sep">·</span>{{ c.tooling|join("+") }}{% endif %}
        {% if c.has_terraform_module %}<span class="sep">·</span>tf{% endif %}
      </td>
      <td class="num ok">{{ c.present }}</td>
      <td class="num{% if c.clear_gap %} gap{% endif %}">{{ c.clear_gap }}</td>
      <td class="num{% if c.worth %} worth{% endif %}">{{ c.worth }}</td>
      <td>
        {% for g in c.gaps -%}
          <span class="gap" title="{{ g.rationale }}">{{ g.feature }}</span>{% if g.ai_escalated %}<span class="ai-badge" title="LLM escalated this from worth-considering to clear-gap">AI</span>{% endif %}{% if not loop.last %}, {% endif %}
        {%- endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="empty-state" data-empty-for="charm-table" hidden>No charms match these filters.</p>

<h2 id="team-view">By team</h2>
<p class="meta" style="margin-top:-1em">
  Aggregates per team. Rows sorted by total clear-gap count (most to least).
  Avg gap = clear-gap labels per charm, a rough "how much migration work
  is in this team's queue" signal that controls for team size.
</p>

<div class="filters" data-filter-bar="team-table">
  <span class="label">Only:</span>
  <div class="group" data-multi="only" data-match="all">
    <button data-value="gaps" title="Teams with at least one clear-gap finding">with clear gaps</button>
  </div>
  <input type="search" data-search-input placeholder="search team…"
         title="Terms are ANDed. Prefix with - to exclude, use team: or gap: to target a field."
         autocomplete="off">
  <button type="button" class="clear-all" data-clear>clear</button>
  <span class="visible-count" data-count></span>
</div>

<table id="team-table">
  <thead>
    <tr>
      <th data-sort="text">Team</th>
      <th data-sort="num">Charms</th>
      <th data-sort="num">Present</th>
      <th data-sort="num">Clear gap</th>
      <th data-sort="num">Worth considering</th>
      <th data-sort="num">Avg gap/charm</th>
      <th>Architecture mix</th>
      <th>Top clear-gap features</th>
    </tr>
  </thead>
  <tbody>
  {% for t in team_rows %}
    <tr
      data-only="{{ 'gaps' if t.clear_gap }}"
      data-team="{{ t.team|lower }}"
      data-gaps="{{ t.top_gaps|map(attribute='0')|join(' ')|lower }}"
      data-search="{{ (t.team + ' ' + t.top_gaps|map(attribute='0')|join(' '))|lower }}"
    >
      <td>
        <strong><a class="xlink" href="?charm.team={{ t.team|urlencode }}#charm-view"
                   title="List this team's charms">{{ t.team }}</a></strong>
      </td>
      <td class="num">{{ t.charms }}</td>
      <td class="num ok">{{ t.present }}</td>
      <td class="num{% if t.clear_gap %} gap{% endif %}">{{ t.clear_gap }}</td>
      <td class="num{% if t.worth %} worth{% endif %}">{{ t.worth }}</td>
      <td class="num">{{ t.avg_gap }}</td>
      <td>
        {% for arch, n in t.architecture -%}
          <span class="chip chip-arch-{{ arch }}">{{ arch }}&nbsp;{{ n }}</span>
        {%- endfor %}
      </td>
      <td>
        {% for fname, n in t.top_gaps -%}
          <span class="gap" title="{{ n }} charm{{ '' if n == 1 else 's' }} in {{ t.team }}">{{ fname }}&nbsp;({{ n }})</span>{% if not loop.last %}, {% endif %}
        {%- endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="empty-state" data-empty-for="team-table" hidden>No teams match these filters.</p>

{% if pairs %}
<h2 id="pairs-view">k8s/machine pairs</h2>
<p class="meta">
  {{ pairs|length }} pair{{ "" if pairs|length == 1 else "s" }} identified by
  name normalisation. <em>High</em> = identical root after stripping
  <code>-k8s</code> / <code>-operator</code>; <em>medium</em> = within
  edit-distance 2. <code>shared lib</code> means either side vendors a
  <code>lib/charms/&lt;n&gt;/</code> whose name normalises to the other's root.
  Sub-metrics <em>shared-src</em> / <em>copy-paste</em> / <em>% unique code</em>
  are v2.
</p>
<table id="pairs-table">
  <thead>
    <tr>
      <th>Root</th>
      <th>k8s charm</th>
      <th>Machine charm</th>
      <th>Confidence</th>
      <th>Repo</th>
      <th>Code sharing</th>
    </tr>
  </thead>
  <tbody>
  {% for p in pairs %}
    <tr>
      <td>{{ p.root }}</td>
      <td><a href="{{ p.k8s_repo_url }}">{{ p.k8s_name }}</a></td>
      <td><a href="{{ p.machine_repo_url }}">{{ p.machine_name }}</a></td>
      <td>
        {% if p.confidence == "high" %}
          <span class="chip chip-flag" title="Identical name root after stripping -k8s / -operator">high</span>
        {% else %}
          <span class="chip" title="Edit-distance ≤ 2 between roots">medium</span>
        {% endif %}
      </td>
      <td>
        {% if p.same_repo %}<span class="chip chip-flag" title="Both members share the same repo URL">same repo</span>
        {% else %}<span class="chip" title="Different repos">separate</span>{% endif %}
      </td>
      <td>
        {% if p.shares_charmlib %}<span class="chip chip-flag" title="Either side vendors a charmlib whose name normalises to the other's root">shared lib</span>
        {% else %}<span class="chip" title="No shared charmlib detected (shared-src / copy-paste is v2)">—</span>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<details>
  <summary>Evidence (all clear-gap findings)</summary>
  <ul class="ev">
    {% for item in evidence_log %}
    <li>
      <strong>{{ item.charm }}</strong> /
      <span class="lib-{{ item.library }}">{{ item.feature }}</span>:
      {{ item.rationale }}
    </li>
    {% endfor %}
  </ul>
</details>

<script>
// Filter + sort machinery for the dashboard's tables.
//
// Filter bars are declared in markup: `data-filter-bar="<table id>"` on the
// bar, and controls inside it carrying `data-multi` / `data-single` (button
// groups), `data-select`, `data-search-input` or `data-feature-input`. A row
// is visible iff it satisfies every control.
//
// The whole state — filters and sort, for all tables — round-trips through
// the query string (`charm.arch=reconcile&charm.q=team:observability`), so a
// filtered view can be linked and the Back button steps through it. Query
// string rather than the hash, because the hash is already the nav anchors.
(function () {
  'use strict';

  // Fields the search box can target with `field:value`, per table, mapped
  // to the data- attribute holding that field. Unknown prefixes are treated
  // as literal text so `ops.pebble:foo` doesn't silently match everything.
  const SEARCH_FIELDS = {
    charm: {
      charm: 'name', name: 'name', team: 'team', repo: 'repo', stack: 'stack',
      arch: 'arch', flag: 'flags', feature: 'features', gap: 'gaps',
    },
    feature: {feature: 'name', name: 'name', lib: 'library', library: 'library'},
    team: {team: 'team', gap: 'gaps'},
  };
  const FEATURE_MODES = ['has', 'lacks', 'gap'];

  // ── URL state ──────────────────────────────────────────────────────────
  const syncers = [];

  function urlGet(key) {
    return new URLSearchParams(location.search).get(key) || '';
  }

  function urlSet(updates, push) {
    const p = new URLSearchParams(location.search);
    Object.keys(updates).forEach(function (k) {
      if (updates[k]) p.set(k, updates[k]);
      else p.delete(k);
    });
    const qs = p.toString();
    const url = location.pathname + (qs ? '?' + qs : '') + location.hash;
    // Discrete clicks push, so Back steps through them; typing replaces,
    // otherwise every keystroke would land its own history entry.
    history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  window.addEventListener('popstate', function () {
    syncers.forEach(function (fn) { fn(); });
  });

  // ── search query parsing ───────────────────────────────────────────────
  // `foo -bar team:"data platform"` → three ANDed terms, one negated, one
  // restricted to a single field.
  function tokenize(text) {
    const out = [];
    let tok = '';
    let quoted = false;
    for (const ch of text) {
      if (ch === '"') { quoted = !quoted; continue; }
      if (!quoted && /\s/.test(ch)) {
        if (tok) out.push(tok);
        tok = '';
        continue;
      }
      tok += ch;
    }
    if (tok) out.push(tok);
    return out;
  }

  function parseQuery(text, fields) {
    return tokenize(text.toLowerCase()).map(function (raw) {
      let tok = raw;
      let negate = false;
      if (tok.length > 1 && tok[0] === '-') { negate = true; tok = tok.slice(1); }
      let key = null;
      const colon = tok.indexOf(':');
      if (colon > 0 && fields[tok.slice(0, colon)]) {
        key = fields[tok.slice(0, colon)];
        tok = tok.slice(colon + 1);
      }
      return {key: key, needle: tok, negate: negate};
    }).filter(function (t) { return t.needle; });
  }

  function queryMatches(terms, row) {
    return terms.every(function (t) {
      const hay = (row.dataset[t.key || 'search'] || '').toLowerCase();
      return hay.includes(t.needle) !== t.negate;
    });
  }

  function tokens(row, key) {
    return (row.dataset[key] || '').split(' ').filter(Boolean);
  }

  // ── filter bars ────────────────────────────────────────────────────────
  function setupBar(bar) {
    const table = document.getElementById(bar.dataset.filterBar);
    if (!table || !table.tBodies.length) return;
    const rows = Array.from(table.tBodies[0].rows);
    const prefix = table.id.replace(/-table$/, '');
    const fields = SEARCH_FIELDS[prefix] || {};
    const countEl = bar.querySelector('[data-count]');
    const emptyEl = document.querySelector('[data-empty-for="' + table.id + '"]');
    const searchEl = bar.querySelector('[data-search-input]');
    const clearEl = bar.querySelector('[data-clear]');
    const featureInput = bar.querySelector('[data-feature-input]');
    const featureMode = bar.querySelector('[data-feature-mode]');
    const chipsEl = bar.querySelector('[data-feature-chips]');
    const datalist = featureInput && document.getElementById(featureInput.getAttribute('list'));
    const featureNames = new Set(datalist ? Array.from(datalist.options).map(function (o) { return o.value; }) : []);

    // `data-multi` groups OR their picks together (any arch), unless
    // `data-match="all"` makes them AND (every flag). `data-single` groups
    // are radio-style; the empty-valued button in each group means "no
    // filter for this group".
    const groups = Array.from(bar.querySelectorAll('.group')).map(function (el) {
      return {
        el: el,
        key: el.dataset.multi || el.dataset.single,
        multi: Boolean(el.dataset.multi),
        all: el.dataset.match === 'all',
        values: [],
      };
    });
    const selects = Array.from(bar.querySelectorAll('[data-select]'));
    const state = {search: '', terms: [], features: []};

    function param(key) { return prefix + '.' + key; }

    function matches(row) {
      for (const g of groups) {
        if (!g.values.length) continue;
        const have = tokens(row, g.key);
        const ok = g.multi && !g.all
          ? g.values.some(function (v) { return have.includes(v); })
          : g.values.every(function (v) { return have.includes(v); });
        if (!ok) return false;
      }
      for (const sel of selects) {
        if (!sel.value) continue;
        const raw = row.dataset[sel.dataset.select] || '';
        const ok = sel.hasAttribute('data-exact') ? raw === sel.value : tokens(row, sel.dataset.select).includes(sel.value);
        if (!ok) return false;
      }
      for (const f of state.features) {
        const present = tokens(row, 'features').includes(f.name);
        if (f.mode === 'has' && !present) return false;
        if (f.mode === 'lacks' && present) return false;
        if (f.mode === 'gap' && !tokens(row, 'gaps').includes(f.name)) return false;
      }
      return queryMatches(state.terms, row);
    }

    function apply() {
      let visible = 0;
      rows.forEach(function (r) {
        const show = matches(r);
        r.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      const filtered = visible !== rows.length;
      if (countEl) {
        countEl.textContent = filtered
          ? visible + ' / ' + rows.length + ' shown'
          : rows.length + ' rows';
        countEl.classList.toggle('filtered', filtered);
      }
      if (emptyEl) emptyEl.hidden = visible !== 0;
      table.classList.toggle('all-hidden', visible === 0);
    }

    function paintGroup(g) {
      g.el.querySelectorAll('button').forEach(function (btn) {
        const v = btn.dataset.value || '';
        btn.classList.toggle('active', v ? g.values.includes(v) : !g.values.length);
      });
    }

    function paintSelect(sel) {
      sel.classList.toggle('set', Boolean(sel.value));
    }

    function renderChips() {
      if (!chipsEl) return;
      chipsEl.textContent = '';
      state.features.forEach(function (f) {
        const chip = document.createElement('span');
        chip.className = 'feature-chip feature-chip-' + f.mode;
        if (f.mode !== 'has') {
          const mode = document.createElement('span');
          mode.className = 'mode';
          mode.textContent = f.mode === 'lacks' ? 'lacks ' : 'gap ';
          chip.appendChild(mode);
        }
        chip.appendChild(document.createTextNode(f.name));
        const x = document.createElement('button');
        x.type = 'button';
        x.textContent = '×';
        x.title = 'remove ' + f.name;
        x.addEventListener('click', function () {
          state.features = state.features.filter(function (o) {
            return !(o.name === f.name && o.mode === f.mode);
          });
          renderChips();
          apply();
          writeUrl(true);
        });
        chip.appendChild(x);
        chipsEl.appendChild(chip);
      });
    }

    function addFeature(name) {
      name = (name || '').trim();
      const mode = featureMode ? featureMode.value : 'has';
      if (!name || !featureNames.has(name)) return false;
      const dupe = state.features.some(function (f) {
        return f.name === name && f.mode === mode;
      });
      if (dupe) return false;
      state.features.push({name: name, mode: mode});
      renderChips();
      apply();
      writeUrl(true);
      return true;
    }

    function writeUrl(push) {
      const updates = {};
      groups.forEach(function (g) { updates[param(g.key)] = g.values.join(','); });
      selects.forEach(function (s) { updates[param(s.dataset.select)] = s.value; });
      updates[param('q')] = state.search;
      updates[param('feat')] = state.features.map(function (f) {
        return f.mode + ':' + f.name;
      }).join(',');
      urlSet(updates, push);
    }

    function readUrl() {
      groups.forEach(function (g) {
        const raw = urlGet(param(g.key));
        g.values = raw ? raw.split(',').filter(Boolean) : [];
        if (!g.multi) g.values = g.values.slice(0, 1);
        paintGroup(g);
      });
      selects.forEach(function (s) {
        const want = urlGet(param(s.dataset.select));
        s.value = want;
        if (s.selectedIndex < 0) s.value = '';
        paintSelect(s);
      });
      state.search = urlGet(param('q'));
      state.terms = parseQuery(state.search, fields);
      if (searchEl) searchEl.value = state.search;
      state.features = urlGet(param('feat')).split(',').filter(Boolean).map(function (spec) {
        const colon = spec.indexOf(':');
        const mode = colon > 0 ? spec.slice(0, colon) : 'has';
        return {
          name: colon > 0 ? spec.slice(colon + 1) : spec,
          mode: FEATURE_MODES.includes(mode) ? mode : 'has',
        };
      }).filter(function (f) { return featureNames.has(f.name); });
      renderChips();
      apply();
    }

    groups.forEach(function (g) {
      g.el.querySelectorAll('button').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const v = btn.dataset.value || '';
          if (!v) g.values = [];
          else if (!g.multi) g.values = [v];
          else if (g.values.includes(v)) g.values = g.values.filter(function (x) { return x !== v; });
          else g.values = g.values.concat([v]);
          paintGroup(g);
          apply();
          writeUrl(true);
        });
      });
    });

    selects.forEach(function (sel) {
      sel.addEventListener('change', function () {
        paintSelect(sel);
        apply();
        writeUrl(true);
      });
    });

    if (searchEl) {
      searchEl.addEventListener('input', function () {
        state.search = searchEl.value.trim();
        state.terms = parseQuery(state.search, fields);
        apply();
        writeUrl(false);
      });
      // Enter / blur closes off an edit: give it its own history entry.
      searchEl.addEventListener('change', function () { writeUrl(true); });
    }

    if (featureInput) {
      featureInput.addEventListener('change', function () {
        if (addFeature(featureInput.value)) featureInput.value = '';
      });
      featureInput.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        if (addFeature(featureInput.value)) featureInput.value = '';
      });
    }

    if (clearEl) {
      clearEl.addEventListener('click', function () {
        groups.forEach(function (g) { g.values = []; paintGroup(g); });
        selects.forEach(function (s) { s.value = ''; paintSelect(s); });
        state.search = '';
        state.terms = [];
        state.features = [];
        if (searchEl) searchEl.value = '';
        if (featureInput) featureInput.value = '';
        renderChips();
        apply();
        writeUrl(true);
      });
    }

    syncers.push(readUrl);
    readUrl();
  }

  document.querySelectorAll('[data-filter-bar]').forEach(setupBar);

  // ── column sorting ─────────────────────────────────────────────────────
  // Click a th to sort by that column, click again to reverse. The pick is
  // kept in the URL alongside the filters (`charm.sort=5:desc`).
  document.querySelectorAll('table').forEach(function (table) {
    const ths = Array.from(table.querySelectorAll('th[data-sort]'));
    if (!ths.length || !table.tBodies.length) return;
    const tbody = table.tBodies[0];
    const original = Array.from(tbody.rows);
    const key = (table.id || '').replace(/-table$/, '') + '.sort';

    function paint(th, asc) {
      ths.forEach(function (t) { t.classList.remove('sorted-asc', 'sorted-desc'); });
      if (th) th.classList.add(asc ? 'sorted-asc' : 'sorted-desc');
    }

    function sortBy(th, asc) {
      const idx = th.cellIndex;
      const type = th.dataset.sort;
      const rows = Array.from(tbody.rows);
      rows.sort(function (a, b) {
        const av = a.cells[idx].textContent.trim();
        const bv = b.cells[idx].textContent.trim();
        if (type === 'num') return (parseFloat(av) || 0) - (parseFloat(bv) || 0);
        return av.localeCompare(bv);
      });
      if (!asc) rows.reverse();
      rows.forEach(function (r) { tbody.appendChild(r); });
      paint(th, asc);
    }

    function readUrl() {
      const raw = table.id ? urlGet(key) : '';
      const parts = raw.split(':');
      const th = ths.filter(function (t) { return String(t.cellIndex) === parts[0]; })[0];
      if (!th) {
        original.forEach(function (r) { tbody.appendChild(r); });
        paint(null, true);
        return;
      }
      sortBy(th, parts[1] !== 'desc');
    }

    ths.forEach(function (th) {
      th.addEventListener('click', function () {
        const asc = !th.classList.contains('sorted-asc');
        sortBy(th, asc);
        if (table.id) {
          const updates = {};
          updates[key] = th.cellIndex + ':' + (asc ? 'asc' : 'desc');
          urlSet(updates, true);
        }
      });
    });

    if (table.id) {
      syncers.push(readUrl);
      readUrl();
    }
  });
})();
</script>

</body>
</html>
