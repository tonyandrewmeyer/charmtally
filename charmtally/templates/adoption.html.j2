<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>charmtally — charm tech adoption</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu+Sans:ital,wght@0,100..800;1,100..800&family=Ubuntu+Sans+Mono:wght@400..700&display=swap">
<style>
{% include "_canonical.css.j2" %}
  :root { --page-width: 1200px; }
  h1 { margin-bottom: .25rem; }
  .meta { max-width: 70ch; margin: 0 0 1.5rem 0; }
  table { margin: 0 0 1em 0; font-size: 13px; }

  /* Headline cards, after Vanilla's p-card: square, hairline-bordered,
     with a top accent rule. */
  .cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem; margin: 1.5rem 0 2.5rem 0;
  }
  .card {
    border: 1px solid var(--c-border); border-top: 3px solid var(--c-text);
    padding: 1rem 1.25rem 1.25rem; background: var(--c-bg);
  }
  .card h2 { font-size: 1rem; font-weight: 550; margin: 0 0 .2em 0; }
  .card .q { color: var(--c-text-muted); font-size: 12px; margin: 0 0 .8em 0; }
  .headline {
    font-size: 2.75rem; font-weight: 200; font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .headline .unit { font-size: 1.25rem; color: var(--c-text-muted); }
  .card .headline-label { font-size: 13px; margin: .1em 0 0 0; }
  .delta { font-size: 13px; margin-left: .4em; font-weight: 550; }
  .delta.up { color: var(--c-positive); }
  .delta.down { color: var(--c-negative); }
  .delta.flat, .delta.none { color: var(--c-text-faint); font-weight: 400; }
  .card .basis { color: var(--c-text-muted); font-size: 12px; margin-top: .6em; }
  .card .denom { color: var(--c-caution); }
  .card.pending { background: var(--c-bg-alt); border-top-color: var(--c-border); }
  .card.pending .headline { color: var(--c-text-faint); }

  section.metric { border-top: 1px solid var(--c-border); padding-top: 1.2em; margin-top: 2.5em; }
  section.metric h2 { margin: 0 0 .3em 0; }
  .detail { color: var(--c-text); max-width: 70ch; margin: 0 0 .8em 0; }
  .caveats { color: var(--c-caution); font-size: 12px; max-width: 70ch; }
  .partial { color: var(--c-caution); font-size: 12px; }
  .chart-key { font-size: 12px; max-width: 70ch; margin: 0 0 .4em 0; }
  .chart-key .swatch {
    display: inline-block; width: 1.6em; height: 2px; background: #000;
    vertical-align: middle; margin-right: .3em;
  }
  .since { color: var(--c-text-muted); font-size: 12px; max-width: 70ch; margin: -.4em 0 .8em 0; }
  .chart { height: 320px; }
  .pending-note {
    border-left: 3px solid var(--c-caution); background: var(--c-caution-bg);
    padding: .6em .9em; color: var(--c-text); max-width: 70ch;
  }
  .counts { display: flex; flex-wrap: wrap; gap: 1.6em; margin: .8em 0 1em 0; }
  .counts h3 { font-size: 13px; margin: 0 0 .3em 0; color: var(--c-text-muted); }
  .counts table { font-size: 13px; }
  .counts td { padding: .15em .8em .15em 0; }
  .counts .asof { flex-basis: 100%; color: var(--c-text-faint); font-size: 12px; margin: 0; }

  details.fallback { margin: .6em 0 1em 0; }
  details.fallback summary { font-size: 12px; }
  details.fallback table { margin-top: .6em; }
  .impl { font-size: 12px; color: var(--c-text-muted); margin: .4em 0 .8em 0; }
  details.members { margin: .6em 0 1em 0; max-width: 90ch; }
  details.members > summary { font-size: 12px; }
  details.members details { margin: .3em 0 0 1em; }
  details.members details summary { font-size: 13px; }
  details.members .list { font-size: 12px; line-height: 1.7; margin: .3em 0 .6em 1em; }
  details.members .hint { font-size: 12px; color: var(--c-text-muted); margin: .4em 0 0 0; }
  section.method { max-width: 70ch; }
  section.method dt { font-weight: 550; margin-top: .8em; }
  section.method dd { margin: .2em 0 0 0; }
</style>
</head>
<body>
{% set active = 'adoption' %}
{% include "_header.html.j2" %}
<main>

<h1>charm tech adoption</h1>
<p class="meta">
  Is the tooling charm tech ships being picked up? A small, deliberately
  stable set of metrics across the scanned charm corpus.
  {% if generated_at %}Generated {{ generated_at }}.{% endif %}
  <a href="#method">How this is measured</a>.
</p>

<div class="cards">
  {% for card in cards %}
  <div class="card{{ ' pending' if card.pending else '' }}">
    <h2>{{ card.metric.title }}</h2>
    <p class="q">{{ card.metric.question }}</p>
    {% if card.latest %}
    <div class="headline">
      {{ card.latest.value }}<span class="unit">%</span>
      {% if card.delta is none %}
      <span class="delta none" title="only one reading so far">—</span>
      {% elif card.delta > 0 %}
      <span class="delta up">▲ {{ card.delta }}</span>
      {% elif card.delta < 0 %}
      <span class="delta down">▼ {{ -card.delta }}</span>
      {% else %}
      <span class="delta flat">no change</span>
      {% endif %}
    </div>
    {% if card.metric.headline %}<p class="headline-label">{{ card.metric.headline }}</p>{% endif %}
    <p class="basis">
      {{ card.latest.numerator }} / {{ card.latest.denominator }} charms,
      {{ card.latest.date }}
      {% if card.metric.denominator_note %}
      <br><span class="denom">Denominator: {{ card.metric.denominator_note|safe }}.</span>
      {% endif %}
    </p>
    {% else %}
    <div class="headline">—</div>
    <p class="basis">{{ card.pending or "no data yet" }}</p>
    {% endif %}
  </div>
  {% endfor %}
</div>

{% for card in cards %}
<section class="metric" id="metric-{{ card.metric.key }}">
  <h2>{{ card.metric.title }}</h2>
  <p class="detail">{{ card.metric.detail|safe }}</p>
  {% if card.metric.since_note %}
  <p class="since">Series starts {{ card.metric.since }}: {{ card.metric.since_note|safe }}.</p>
  {% endif %}

  {% if card.series %}
  {% if card.metric.headline %}
  <p class="chart-key">
    <span class="swatch"></span>Black line, the headline: <strong>{{ card.metric.headline }}</strong>
    {%- if card.metric.headline_keys|length > 1 %} — the
    {% for key in card.metric.headline_keys %}<em>{{ key }}</em>{{ ", " if loop.revindex > 2 else (" and " if loop.revindex == 2 else "") }}{% endfor %}
    bands added together{% endif %}.
  </p>
  {% endif %}
  <div class="chart" id="chart-{{ card.metric.key }}"></div>

  <details class="fallback">
  <summary>Static fallback — headline value and breakdown, per snapshot date</summary>
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th class="num">{{ card.metric.headline or card.metric.title }}</th>
        {% for key in card.metric.breakdown_keys %}<th class="num">{{ key }}</th>{% endfor %}
        <th class="num">charms</th>
      </tr>
    </thead>
    <tbody>
      {% for point in card.series %}
      <tr>
        <td>{{ point.date }}</td>
        <td class="num">{{ point.value }}%</td>
        {% for key in card.metric.breakdown_keys %}
        <td class="num">
          {% if key in point.breakdown %}{{ point.breakdown[key] }}%{% else %}—{% endif %}
        </td>
        {% endfor %}
        <td class="num">{{ point.denominator }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </details>

  {% if card.metric.count_tables and card.latest %}
  <div class="counts">
    {% for heading, rows in card.metric.count_tables %}
    <div>
      <h3>{{ heading }}</h3>
      <table>
        {% for key, label in rows %}
        <tr>
          <td class="num">{{ card.latest.counts.get(key, "—") }}</td>
          <td>{{ label|safe }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
    <p class="asof">As of {{ card.latest.date }}. Earlier dates are in the JSON.</p>
  </div>
  {% endif %}

  {% if card.latest and card.latest.partial %}
  <p class="partial">Latest point is partial: {{ card.latest.partial }}.</p>
  {% endif %}
  {% if card.members %}
  <details class="members">
  <summary>Charms behind the {{ card.latest.date }} point, by bucket</summary>
  {% for group in card.members %}
  <details>
    <summary>{{ group.bucket }} — {{ group.names|length }}</summary>
    {% if group.names %}
    <p class="list" data-member-href="{{ group.href }}">{{ group.names|join(", ") }}</p>
    {% endif %}
  </details>
  {% endfor %}
  <p class="hint">
    Each charm links to its row on the Tally{% if card.metric.bucket_features %}; in a bucket
    that is one feature&rsquo;s reading, with that feature selected, which lists the
    file and line the detector matched{% endif %}.
    {% if card.metric.scope != "charms" %}Rocks link to their <code>rockcraft.yaml</code>.{% endif %}
    The Tally is the latest scan, so it can disagree with an older point.
  </p>
  </details>
  {% endif %}
  {% else %}
  <p class="pending-note">
    No series yet — {{ card.pending or "no snapshot carries the inputs for this metric" }}.
  </p>
  {% endif %}

  {% if card.metric.caveats %}
  <ul class="caveats">
    {% for c in card.metric.caveats %}<li>{{ c|safe }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if card.source_url %}
  <p class="impl">
    How it is computed: <a href="{{ card.source_url }}"><code>{{ card.metric.compute.__name__ }}</code></a>
    {%- if card.metric.inputs %}, reading
    {% for f in card.metric.inputs %}<a href="dashboard.html?feature.q=feature:{{ f|urlencode }}#feature-view"><code>{{ f }}</code></a>{{ ", " if not loop.last }}{% endfor %}
    {%- endif %}.
  </p>
  {% endif %}
</section>
{% endfor %}

<section class="method" id="method">
<h2>How this is measured</h2>
<dl>
  <dt>What is counted</dt>
  <dd>
    One <em>charm</em>: a directory with charm metadata (<code>charmcraft.yaml</code>
    or <code>metadata.yaml</code>) in a repository the corpus lists. A monorepo
    contributes one charm per sub-charm, so a repository holding five charms is
    five data points, and anything read from the repository rather than the
    charm directory &mdash; its CI workflows, its last commit &mdash; reads the
    same for all five. The rootless card also counts <em>rocks</em>, one per
    <code>rockcraft.yaml</code>.
  </dd>
  <dt>Which charms</dt>
  <dd>
    The corpus is the charm list in
    <a href="https://github.com/canonical/hyrum/blob/main/charm-list/charms.csv">canonical/hyrum</a>,
    fetched on every scan, less the exclusions in
    <a href="{{ overrides_url }}"><code>corpus-overrides.yaml</code></a>.
  </dd>
  <dt>Which code</dt>
  <dd>
    The head of each repository&rsquo;s default branch (or the branch the corpus
    names) when the scan ran &mdash; the source, not what is released to any
    Charmhub channel. Only the Charmhub card asks the store anything, and all it
    asks is whether the charm is listed.
  </dd>
  <dt>When</dt>
  <dd>
    A scan runs every Monday at 02:00 UTC and each one is a point on the
    charts. Points from before the weekly scan existed were backfilled by
    checking each repository out at its last commit before 02:00 UTC on that
    date. A card&rsquo;s series starts where the thing it measures was first
    released.
  </dd>
  <dt>How a charm is read</dt>
  <dd>
    By static analysis of the charm&rsquo;s files: the detectors for each
    catalogue feature, described on the
    <a href="dashboard.html#feature-view">Tally</a>, plus the charm&rsquo;s
    metadata. Nothing is deployed or run. Each card links to the function that
    computes it, and the Tally shows the file and line each feature was found on.
  </dd>
</dl>
<p>
  Every denominator on this page counts only <em>actively-maintained</em>
  charms: those whose repository has seen a commit in the two years before
  that snapshot&rsquo;s date. A charm nobody has touched since before these
  APIs existed is not one anyone is going to migrate, so counting it would
  measure abandonment rather than adoption.
</p>
<p>
  Unless a card says otherwise, the denominator narrows further to
  <em>eligible</em> charms: active charms minus reactive and legacy-classic
  ones, which pre-date ops and could never adopt these APIs. Metrics about
  tooling that works whatever the charm is built on — Jubilant, say — measure
  against every active charm instead, and name that on the card. The corpus
  itself grows between scans, so read a series as a share, not as a count.
</p>
<p>
  The metrics are all in <a href="{{ adoption_source_url }}"><code>adoption.py</code></a>.
</p>
</section>

<script type="application/json" id="adoption-metrics-data">{{ chart_data|tojson }}</script>

{# Plotly from the CDN with SRI, same pin as the history page — keep the two
   in step. The hash pins plotly-2.35.2.min.js exactly; regenerate it whenever
   the version in the URL changes:
     curl -sSfL <url> | openssl dgst -sha384 -binary | openssl base64 -A #}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"
        integrity="sha384-cCVCZkAjYNxaYKbM8lsArLznDF/SvMFr1jcZrvOpSTCa0W40ZAdLzHCEulnUa5i7"
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>
<script>
// Bucket member lists are rendered as plain comma-separated names (a link
// apiece was the corpus again per card); this turns each into a link to the
// charm's Tally row, built from the list's `data-member-href` prefix (see
// `dashboard._member_href`). A `rock:owner/repo:path` entry links to that
// rockcraft.yaml instead. Runs before, and independently of, Plotly, so the
// lists link up even when the CDN is unreachable.
(function () {
  document.querySelectorAll('[data-member-href]').forEach(function (list) {
    const prefix = list.dataset.memberHref;
    const names = list.textContent.split(',').map(function (n) { return n.trim(); }).filter(Boolean);
    list.textContent = '';
    names.forEach(function (name, i) {
      if (i) list.appendChild(document.createTextNode(', '));
      const a = document.createElement('a');
      if (name.indexOf('rock:') === 0) {
        const slug = name.slice(5);
        const colon = slug.indexOf(':');
        a.href = 'https://github.com/' + slug.slice(0, colon) + '/blob/HEAD/' + slug.slice(colon + 1);
        a.title = 'rock: its rockcraft.yaml at the default branch';
      } else {
        a.href = prefix + encodeURIComponent(name) + '#charm-view';
      }
      a.textContent = name;
      list.appendChild(a);
    });
  });
})();
</script>
<script>
{% include "_plotly_theme.js.j2" %}
// Per-metric charts — progressive enhancement over the static tables above.
// If the CDN script fails to load (offline, CSP), Plotly is undefined and
// this block is a no-op; the tables remain the source of truth.
(function () {
  if (typeof Plotly === 'undefined') return;
  const metrics = JSON.parse(
    document.getElementById('adoption-metrics-data').textContent);

  metrics.forEach(m => {
    const el = document.getElementById('chart-' + m.key);
    if (!el || !m.series.length) return;
    const dates = m.series.map(p => p.date);

    // Breakdown as stacked areas (the composition), headline as a line on
    // top (the number the card reports). The headline is one of the
    // breakdown keys, so it is drawn again rather than left implicit —
    // reading it off a stack boundary is exactly what stacked charts are
    // bad at.
    const traces = m.breakdown_keys.map(key => ({
      name: key,
      x: dates,
      y: m.series.map(p => (key in p.breakdown ? p.breakdown[key] : null)),
      stackgroup: 'one',
      groupnorm: '',
      mode: 'none',
      hovertemplate: '%{y}% ' + key + '<extra></extra>',
    }));
    // Named for what it counts, not the card's title: "Juju versions" on a
    // line drawn over six Juju-version bands does not say which it is.
    const label = m.headline || m.title;
    const sum = m.headline_keys.length > 1 ? ' (' + m.headline_keys.join(' + ') + ')' : '';
    traces.push({
      name: 'headline: ' + label,
      x: dates,
      y: m.series.map(p => p.value),
      mode: 'lines+markers',
      line: { color: '#000', width: 2 },
      marker: { color: '#000' },
      hovertemplate: '%{y}% ' + label + sum + '<extra>headline</extra>',
    });

    Plotly.newPlot(el, traces, {
      ...CANONICAL_PLOT,
      // Per-metric denominators differ (see `denominator_note`), so the axis
      // label stays generic; the card names the population.
      yaxis: { ...CANONICAL_AXIS, title: '% of charms', range: [0, 100] },
      xaxis: { ...CANONICAL_AXIS, title: 'snapshot date' },
      margin: { t: 20 },
      height: 320,
    }, { responsive: true, displayModeBar: false });
  });
})();
</script>

</main>
</body>
</html>
